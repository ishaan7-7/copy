# ============================================
# STREAMING EMULATOR — GITIGNORE
# ============================================

# DATA FILES
*.csv
*.zip
*.tgz

# DOCUMENTS
*.md
!SETUP.md

# RUNTIME
*.pid
*.log
*.tmp
*.jsonl

# PYTHON
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# VIRTUAL ENVIRONMENTS
.venv/
venv/
master_dashboard/.venv_dash/

# DELTA LAKE / SPARK (regenerated by pipeline)
data/delta/**
!data/delta/**/
!data/delta/**/.gitkeep
data/checkpoints/**
!data/checkpoints/**/
!data/checkpoints/**/.gitkeep
data/spark-warehouse/**
!data/spark-warehouse/**/
!data/spark-warehouse/**/.gitkeep

# VEHICLE DATA — split by active vs. inactive (parked/in_service).
#
# Inactive vehicles are precomputed and committed: data/batch (built by
# tools/ingest_historical.py -> run_silver_historical.py ->
# compute_gold_historical.py -> compute_alerts_historical.py) and
# data/computed + data/computed_us (built by tools/precompute_history.py)
# ship as part of the repo so a clone never has to rerun those scripts.
#
# Active vehicles only need data/vehicles (raw source CSVs) to start a
# fresh stream — that's shipped separately as its own zip, not through
# git. Every other active-vehicle layer (data/delta, data/checkpoints,
# data/spark-warehouse, below) is produced by the live pipeline and must
# never be committed, so a clone always starts the stream from scratch.
data/vehicles/**
!data/vehicles/**/
!data/vehicles/**/.gitkeep
data/dtc_history.json
data/session_reset_token.json
data/resolved_alerts.json

# LOGS
logs/**
!logs/.gitkeep

# DLQ
ingest/dlq/**
!ingest/dlq/.gitkeep
replay/dlq/**
!replay/dlq/.gitkeep
*dlq_archive*/

# REPLAY CHECKPOINTS
replay/checkpoints/**
!replay/checkpoints/.gitkeep

# SERVICE STATE (checkpoints/metrics/buffers regenerated at runtime — a
# running service holds these open, so committing them mid-run is also
# how `git add .` fails with "unable to index file ...")
writer_service/state/**
!writer_service/state/.gitkeep
inference_service/state/**
!inference_service/state/.gitkeep
gold_service/state/**
!gold_service/state/.gitkeep
alerts_service/state/**
!alerts_service/state/.gitkeep
analytics_service/state/**
!analytics_service/state/.gitkeep
/state/**
!/state/.gitkeep

# PIPELINE STATE SEED (pickled ML/replay state used to fast-forward a reset
# — a clone must start the live stream from scratch, never resume from a
# prior run's checkpoints)
tools/_seed_baseline/

# NODE / FRONTEND
node_modules/
master_dashboard/frontend/dist/**
!master_dashboard/frontend/dist/.gitkeep
master_dashboard/frontend/.vite/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# EXTRAS (user adds binaries after clone)

# EXTRACTED BY SETUP (user moves to C:\)
/kafka/
/jdk-*/
/tmp/

# TOOLS — EXTRACTED BY SETUP
tools/node/
tools/npm_cache/

# MISC
copy/
kafka_metrics/

!cut_data/vehicles/**/*.csv
